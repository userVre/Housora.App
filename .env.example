GROK_IMAGE_KEY=
# Enable only after deploying Convex workers and setting Grok/Modal/WHOP secrets there.
DURABLE_AI_ENABLED=false
NEXT_PUBLIC_CONVEX_URL=
MODAL_SAM_ENDPOINT=
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=
TRIPO_API_KEY=
TRIPO_TRACKING_SECRET=
SKETCHFAB_API_TOKEN=
CUBICASA_API_KEY=
# Public HTTPS endpoint that receives CubiCasa Conversion API delivery events.
CUBICASA_WEBHOOK_URL=https://your-domain.example/api/cubicasa/webhook
# Keep these false until the native SDK capture and Exporter delivery workflows are complete.
CUBICASA_MOBILE_SDK_READY=false
CUBICASA_EXPORTER_READY=false
# Optional override for CubiCasa QA; production defaults to https://api.cubi.casa/conversion
CUBICASA_API_BASE=
NEXT_PUBLIC_APP_URL=https://your-domain.example
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CONVEX_DEPLOYMENT=
CONVEX_URL=
CLERK_JWT_ISSUER_DOMAIN=
CLERK_FRONTEND_API_URL=
WHOP_COMPANY_ID=
WHOP_PRODUCT_ID=
WHOP_PLAN_CREATOR_MONTHLY=
WHOP_PLAN_CREATOR_YEARLY=
WHOP_PLAN_STUDIO_MONTHLY=
WHOP_PLAN_STUDIO_YEARLY=
WHOP_CREDIT_PACK_50=
WHOP_CREDIT_PACK_150=
WHOP_CREDIT_PACK_400=
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
# Random server-only secret shared by Next.js and Convex. Keep separate from
# provider webhook secrets. Existing deployments temporarily fall back to
# WHOP_WEBHOOK_SECRET until this is configured in both environments.
HOUSORA_SERVER_KEY=
NEXT_POSTHOG_KEY=
NEXT_POSTHOG_HOST=https://us.i.posthog.com
# Keep false during private testing. Set true only after legal/operator details
# are complete and you intentionally want search engines to index the site.
NEXT_PUBLIC_SITE_INDEXABLE=false
# Required before public launch. Keep this template blank; use the exact legal
# values only in Vercel/Convex environment settings, never in Git.
HOUSORA_LEGAL_NAME=
HOUSORA_LEGAL_ADDRESS=
HOUSORA_SUPPORT_EMAIL=
HOUSORA_PRIVACY_EMAIL=
HOUSORA_JURISDICTION=
# Set true only after a qualified legal review of the published policies.
HOUSORA_LEGAL_REVIEWED=false
# Optional: describe any geographic sales restrictions.
HOUSORA_SALES_GEO=
